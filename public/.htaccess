# Hostinger Configuration for GOC Team Management
# ===================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Jika backend Express Node.js berjalan di port internal (misal port 3000):
  # Hilangkan tanda '#' di dua baris di bawah jika menggunakan Apache Reverse Proxy:
  # RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

  # Jangan rewrite permintaan /api/ ke index.html jika backend terpisah
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # 2. Single Page Application (SPA) Client-Side Routing:
  # Arahkan semua request non-file dan non-directory ke index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Keamanan header standar
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
